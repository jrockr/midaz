# Production Environment Variables
# Copy this file to .env.production and fill in actual values

# API Configuration
VITE_API_URL=https://api.midaz.io/v1
VITE_API_TIMEOUT=30000

# Application
VITE_APP_VERSION=1.0.0
VITE_APP_NAME=Midaz Admin Dashboard

# Authentication
VITE_AUTH_ENDPOINT=https://auth.midaz.io
VITE_SESSION_TIMEOUT=1800000

# Monitoring & Analytics
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
VITE_MIXPANEL_TOKEN=your_mixpanel_token

# Feature Flags
VITE_ENABLE_API_INTEGRATION=true
VITE_ENABLE_BATCH_PROCESSING=true
VITE_ENABLE_REAL_TIME_UPDATES=true
VITE_ENABLE_ANALYTICS_TRACKING=true
VITE_ENABLE_ERROR_REPORTING=true

# Performance
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_COMPRESSION=true
VITE_ENABLE_CACHING=true
VITE_CACHE_MAX_AGE=3600000

# Security
VITE_ENABLE_CSP=true
VITE_ENABLE_XSS_PROTECTION=true
VITE_ENABLE_SECURE_HEADERS=true

# Logging
VITE_LOG_LEVEL=warn
VITE_ENABLE_CONSOLE_LOGGING=false
VITE_ENABLE_NETWORK_LOGGING=false

# Third Party Integrations
VITE_AWS_REGION=us-east-1
VITE_AWS_S3_BUCKET=midaz-admin-uploads
VITE_DATADOG_APP_ID=your_datadog_app_id
VITE_DATADOG_CLIENT_TOKEN=your_datadog_client_token
